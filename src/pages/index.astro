---
import BaseLayout from '../layouts/BaseLayout.astro'
import CompanyPageIsland from '../components/islands/CompanyPageIsland'
import { companyFAQs } from '../components/CompanyPage'
import { featuredCaseStudies } from '../data/caseStudies'
import { solutionPages } from '../data/solutionPages'

// The root is the company page; the product lives at /product/. Organization and
// WebSite schema are emitted site-wide by BaseLayout under stable @ids, so this page
// references the company entity instead of declaring a second, conflicting one.
const ORG_ID = 'https://naurra.ai/#organization'

const title = 'Naurra.ai | Custom AI Agents & AI Automation Company'
const description = 'Naurra.ai is an AI company building custom AI agents for business: quoting, CRM, sales, support and operations automation. See real case studies and results.'

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': 'https://naurra.ai/#webpage',
  url: 'https://naurra.ai/',
  name: title,
  description,
  isPartOf: { '@id': 'https://naurra.ai/#website' },
  about: { '@id': ORG_ID },
  primaryImageOfPage: 'https://naurra.ai/og-default.png'
}

// Built from the same array CompanyPage renders, so the markup always matches the visible FAQ.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: companyFAQs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer
    }
  }))
}

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://naurra.ai/#custom-ai-development',
  name: 'Custom AI Agent Development',
  serviceType: ['Custom AI Agent Development', 'AI Workflow Automation', 'Document Intelligence', 'AI Integration', 'AI Consulting'],
  description: 'Custom AI agents and automation systems built around a business\'s exact process: quoting systems, custom CRMs, sales and support automation, document intelligence, operations, and Google Workspace workflows. Fixed-price, engineer-led delivery.',
  url: 'https://naurra.ai/',
  provider: { '@id': ORG_ID },
  areaServed: 'Worldwide',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Custom AI agent solutions',
    url: 'https://naurra.ai/solutions/',
    itemListElement: solutionPages.map((solution) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: solution.name,
        url: `https://naurra.ai/solutions/${solution.slug}/`
      }
    }))
  }
}

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Featured custom AI case studies',
  itemListElement: featuredCaseStudies.slice(0, 4).map((study, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: `https://naurra.ai/case-studies/${study.slug}/`,
    name: study.title
  }))
}
---

<BaseLayout
  title={title}
  description={description}
  keywords="naurra, naurra ai, ai company, custom ai agents, custom ai agents for small business, ai automation company, ai agent development, custom ai solutions, custom ai case studies"
  imageAlt="Naurra.ai, the AI company building custom AI agents and automation systems for businesses"
  url="https://naurra.ai/"
  structuredData={[webPageSchema, serviceSchema, faqSchema, itemListSchema]}
>
  <CompanyPageIsland client:load />
</BaseLayout>
