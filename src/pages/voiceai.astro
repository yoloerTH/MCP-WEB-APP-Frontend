---
import BaseLayout from '../layouts/BaseLayout.astro'
import AppShell from '../components/islands/AppShell'

/**
 * This is an authenticated app route, not a marketing page. AppShell mounts the
 * React SPA client-side only, so there is no server-rendered content to index.
 *
 * It was previously indexed and listed in sitemap.xml, where its entire crawlable
 * body was a visually-hidden keyword block (~673 bytes) — thin content, and a
 * hidden-text pattern Google discounts. Marked noindex 2026-08-07 and removed from
 * the sitemap. If /voiceai/ should rank on product keywords, it needs a real
 * server-rendered marketing page with the SPA moved to /app/voiceai/.
 *
 * Note: deliberately NOT added to robots.txt Disallow — Google must be able to
 * crawl the page to see the noindex directive.
 */
---

<BaseLayout
  title="Voice AI — Naurra.ai"
  description="Naurra.ai voice assistant for Google Workspace."
  url="https://naurra.ai/voiceai/"
  noindex={true}
>
  <AppShell client:only="react" />
</BaseLayout>
