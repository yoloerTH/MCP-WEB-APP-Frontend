---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PremiumFx from '../../components/PremiumFx.astro'
import { totalFootballCaseStudies } from '../../data/caseStudies'
import { TOTAL_FOOTBALL } from '../../data/totalFootballStudies'

const url = `https://naurra.ai${TOTAL_FOOTBALL.hubPath}`
const title = 'Total Football Studio Case Study: 30M+ Organic Views, a SaaS and an App'
const description = 'How Naurra built and runs Total Football Studio: a SaaS product and iPhone app, 30M+ organic views in 3 months, 80K+ followers, plus comment-to-DM, email, login, data, SEO and billing. Eight systems, one business.'

const bySlug = Object.fromEntries(totalFootballCaseStudies.map((s) => [s.slug, s]))
const link = (slug: string) => `/case-studies/${slug}/`

// The order a stranger actually moves through the business, from first view to paying customer.
const journey = [
  { step: 'They see a video', slug: 'ai-motion-graphics-content-engine-social-growth', body: 'A short made entirely by code shows up in their feed. No ads, just organic reach.' },
  { step: 'They comment a word', slug: 'instagram-facebook-comment-to-dm-automation', body: 'They type "433" and get the link in a private message within seconds.' },
  { step: 'They land on the site', slug: 'seo-website-build-domain-migration', body: 'A fast page, also found through Google and AI assistants, asks for their email.' },
  { step: 'They get the emails', slug: 'email-marketing-automation-newsletters-transactional', body: 'A free playbook, a welcome series and a regular newsletter.' },
  { step: 'They sign up in one tap', slug: 'google-apple-sign-in-login-flows', body: 'With Google, Apple or an email link, on the web or the iPhone app.' },
  { step: 'They use the product', slug: 'saas-product-development-web-and-ios-app', body: 'They draw tactics, animate them and share them with their team.' },
  { step: 'They pay', slug: 'stripe-subscription-billing-affiliate-system', body: 'A trial, then a plan, with Apple Pay or Google Pay in one tap.' },
]

const timeline = [
  { date: '9 Aug 2026', text: 'First line of code for the product.' },
  { date: 'Aug 2026', text: 'Web app, website and library live. Hundreds of coaches sign up in the first couple of weeks, all from organic content.' },
  { date: '5 Sept 2026', text: 'Work starts on the native iPhone and iPad app.' },
  { date: '16 Sept 2026', text: 'The whole site moves to totalfootballstudio.com, with Google told the same day.' },
  { date: 'Sept 2026', text: 'iOS app live on the App Store. Team accounts, voice-over videos and live present mode ship.' },
  { date: '1 Oct 2026', text: 'Comment-to-DM bot built and live on Instagram and Facebook in one day.' },
  { date: '2 Oct 2026', text: 'Paid plans, trials, team seats and the affiliate programme go live.' },
]

const stats = [
  { value: TOTAL_FOOTBALL.views, label: 'Organic views', note: TOTAL_FOOTBALL.viewsWindow },
  { value: TOTAL_FOOTBALL.followers, label: 'Followers', note: 'across all social accounts' },
  { value: '100s', label: 'Users', note: 'in a couple of weeks' },
  { value: '8', label: 'Weeks', note: 'from first code to paid plans' },
]

const platforms = ['Facebook', 'Instagram', 'TikTok', 'YouTube', 'App Store', 'Google Search', 'Stripe', 'Supabase', 'SwiftUI', 'Meta Graph API', 'Remotion', 'Astro']

const faqs = [
  { question: 'What is Total Football Studio?', answer: 'A software product for football coaches: an animated tactics board on the web and on iPhone and iPad, with team accounts, voice-over videos and paid plans. It is built and run by Naurra.' },
  { question: 'Is this a client project?', answer: 'No, it is our own business. That is why we can show how every part was built and what it achieved.' },
  { question: 'Did you pay for ads?', answer: 'No. The views, the followers and the sign-ups all came from organic content: short videos, comments turned into messages, and pages that rank in search.' },
  { question: 'Can you build the same systems for my business?', answer: 'Yes. Each of the eight systems works on its own, for any industry. Most businesses start with one, such as comment-to-DM or email automation, and add the rest over time.' },
]

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://naurra.ai/' },
      { '@type': 'ListItem', position: 2, name: 'Case Studies', item: 'https://naurra.ai/case-studies/' },
      { '@type': 'ListItem', position: 3, name: TOTAL_FOOTBALL.name, item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    image: 'https://naurra.ai/og/case-studies/total-football-studio.png',
    description,
    url,
    mainEntityOfPage: url,
    datePublished: '2026-10-02T09:00:00+00:00',
    dateModified: '2026-10-02T09:00:00+00:00',
    author: { '@type': 'Person', name: 'Athanasios-Ioannis Panagiotakopoulos', jobTitle: 'CEO & AI Engineer' },
    publisher: { '@id': 'https://naurra.ai/#organization' },
    about: { '@id': `${url}#software` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    '@id': `${url}#software`,
    name: TOTAL_FOOTBALL.name,
    url: TOTAL_FOOTBALL.url,
    applicationCategory: 'SportsApplication',
    operatingSystem: 'Web, iOS',
    creator: { '@id': 'https://naurra.ai/#organization' },
    sameAs: [TOTAL_FOOTBALL.appStoreUrl],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'The systems behind Total Football Studio',
    itemListElement: totalFootballCaseStudies.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://naurra.ai${link(s.slug)}`,
      name: s.title,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
  },
]

const display = "font-family: 'Sora', sans-serif; font-weight: 800; letter-spacing: -0.045em;"
const brand = 'background: linear-gradient(110deg, #a3e635, #34d399 40%, #fbbf24 70%, #a3e635); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;'
const eyebrow = 'text-xs font-mono uppercase tracking-[0.22em] text-lime-300'
const arrow = '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>'
---

<BaseLayout
  title={title}
  description={description}
  keywords="total football studio, naurra case study, saas product case study, organic social media growth case study, comment to dm automation, email automation case study, supabase case study, stripe billing case study, seo case study, motion graphics content engine"
  image="/og/case-studies/total-football-studio.png"
  imageAlt="Total Football Studio, a product built and run by Naurra.ai"
  url={url}
  type="article"
  publishedTime="2026-10-02T09:00:00+00:00"
  modifiedTime="2026-10-02T09:00:00+00:00"
  structuredData={schemas}
>
  <PremiumFx />
  <div class="relative min-h-screen bg-[#070a13] text-white overflow-hidden" style="font-family: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[1400px]" aria-hidden="true">
      <div class="absolute top-[-15%] right-[-10%] w-[900px] h-[900px] rounded-full bg-lime-400/[0.08] blur-[150px] fx-float"></div>
      <div class="absolute top-[30%] left-[-20%] w-[700px] h-[700px] rounded-full bg-emerald-500/[0.07] blur-[150px]"></div>
    </div>

    <nav class="sticky top-0 z-40 border-b border-white/[0.07] bg-[#070a13]/80 backdrop-blur-xl">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3">
          <img src="/logo-transparent.png" alt="Naurra.ai" class="w-9 h-9 object-contain" />
          <span style={`font-family: 'Sora', sans-serif; font-weight: 800; letter-spacing: -0.04em; font-size: 20px; ${brand}`}>Naurra.ai</span>
        </a>
        <div class="flex items-center gap-5">
          <a href="#systems" class="text-sm text-gray-400 hover:text-white transition-colors font-medium hidden md:inline">The systems</a>
          <a href="/case-studies/" class="text-sm text-gray-400 hover:text-white transition-colors font-medium hidden sm:inline">Case studies</a>
          <a href="/contact/" class="fx-shine text-sm font-semibold px-5 py-2.5 rounded-full text-[#070a13] bg-lime-300 hover:bg-lime-200 transition-colors">Book a free call</a>
        </div>
      </div>
    </nav>

    <!-- HERO -->
    <section class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 lg:pt-14 pb-16">
      <nav class="relative z-10 text-xs text-gray-500 font-mono uppercase tracking-wider flex items-center gap-2 mb-10" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span class="text-gray-700">/</span>
        <a href="/case-studies/" class="hover:text-white transition-colors">Case studies</a>
        <span class="text-gray-700">/</span>
        <span class="text-gray-300 truncate">{TOTAL_FOOTBALL.name}</span>
      </nav>

      <!-- The pitch draws itself, then a passing move plays across it. -->
      <svg class="fx-draw absolute right-[-12%] top-6 w-[115%] sm:w-[85%] lg:w-[68%] opacity-[0.22] pointer-events-none" viewBox="0 0 1050 680" fill="none" aria-hidden="true">
        <g stroke="#a3e635" stroke-width="2" opacity=".55">
          <rect pathLength="1" x="25" y="25" width="1000" height="630" rx="4" />
          <line pathLength="1" x1="525" y1="25" x2="525" y2="655" style="--fx-d:300ms" />
          <circle pathLength="1" cx="525" cy="340" r="91" style="--fx-d:500ms" />
          <rect pathLength="1" x="860" y="178" width="165" height="324" style="--fx-d:700ms" />
          <rect pathLength="1" x="970" y="258" width="55" height="164" style="--fx-d:900ms" />
          <rect pathLength="1" x="25" y="178" width="165" height="324" style="--fx-d:700ms" />
        </g>
        <g stroke="#fbbf24" stroke-width="3" stroke-linecap="round">
          <path pathLength="1" d="M330 470 Q 430 380 560 410" style="--fx-d:1600ms" />
          <path pathLength="1" d="M560 410 Q 690 300 760 220" style="--fx-d:2300ms" />
          <path pathLength="1" d="M760 220 Q 860 260 930 330" style="--fx-d:3000ms" />
        </g>
        <g fill="#a3e635">
          <circle cx="330" cy="470" r="13" /><circle cx="560" cy="410" r="13" /><circle cx="760" cy="220" r="13" /><circle cx="930" cy="330" r="13" />
          <circle cx="440" cy="250" r="13" opacity=".6" /><circle cx="660" cy="540" r="13" opacity=".6" />
        </g>
        <circle r="8" fill="#fff">
          <animateMotion dur="7s" begin="1.6s" repeatCount="indefinite" keyPoints="0;0.33;0.33;0.66;0.66;1;1" keyTimes="0;0.15;0.25;0.4;0.5;0.65;1" calcMode="linear" path="M330 470 Q 430 380 560 410 Q 690 300 760 220 Q 860 260 930 330" />
        </circle>
      </svg>

      <div class="relative max-w-4xl">
        <div data-reveal class="inline-flex items-center gap-2.5 pl-2 pr-4 py-1.5 rounded-full mb-8 bg-white/[0.04] border border-white/10 backdrop-blur">
          <span class="px-2 py-0.5 rounded-full bg-lime-300 text-[#070a13] text-[10px] font-bold uppercase tracking-wider">Live</span>
          <span class="text-xs font-medium text-gray-300">Our own product, grown 100% organically</span>
        </div>
        <h1 data-reveal style={`${display} --fx-d:120ms`} class="text-[2.7rem] sm:text-6xl lg:text-[5.4rem] !leading-[0.95] mb-8">
          We didn't just build it for a client.
          <span class="block fx-gradient-text" style={brand}>We built a whole business and ran it.</span>
        </h1>
        <p data-reveal style="--fx-d:240ms" class="text-lg lg:text-xl text-gray-300 leading-relaxed max-w-2xl mb-4">
          <strong class="text-white font-semibold">Total Football Studio</strong> is a tactics app for football coaches, on the web and on iPhone. We wrote the software, made the videos, and built the marketing, the emails, the logins, the database and the payments.
        </p>
        <p data-reveal style="--fx-d:320ms" class="text-lg text-gray-400 leading-relaxed max-w-2xl mb-10">
          No ads. Every view, follower and sign-up came from organic content. Every system your business might need is on this page, working in production.
        </p>
        <div data-reveal style="--fx-d:420ms" class="flex flex-col sm:flex-row gap-3">
          <a href="#systems" class="fx-shine group inline-flex items-center justify-center gap-2 px-7 py-4 rounded-full font-semibold text-[#070a13] bg-gradient-to-r from-lime-300 to-emerald-300 shadow-[0_10px_40px_-10px_rgba(163,230,53,.6)] hover:shadow-[0_14px_50px_-8px_rgba(163,230,53,.75)] transition-shadow">
            See the eight systems
            <svg class="w-4 h-4 group-hover:translate-y-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" /></svg>
          </a>
          <a href={TOTAL_FOOTBALL.url} target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-full font-semibold text-white bg-white/[0.05] border border-white/10 hover:bg-white/10 hover:border-white/20 transition-colors backdrop-blur">
            Open the live product
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5h5m0 0v5m0-5L10 14M19 13v5a1 1 0 01-1 1H6a1 1 0 01-1-1V6a1 1 0 011-1h5" /></svg>
          </a>
        </div>
      </div>

      <div data-reveal-stagger class="relative grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mt-16 lg:mt-20">
        {stats.map((s) => (
          <div data-spotlight class="rounded-3xl border border-white/10 bg-gradient-to-b from-white/[0.06] to-white/[0.01] backdrop-blur-md px-5 sm:px-6 py-6 sm:py-7">
            <div style={display} class="text-4xl sm:text-5xl lg:text-6xl leading-none"><span data-count style={brand}>{s.value}</span></div>
            <div class="mt-4 text-xs font-semibold uppercase tracking-[0.16em] text-white/85">{s.label}</div>
            <div class="mt-1 text-xs text-gray-500">{s.note}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- PLATFORMS -->
    <div class="relative border-y border-white/[0.06] bg-white/[0.015] py-5 overflow-hidden" style="mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);">
      <div class="fx-marquee gap-10 pr-10">
        {[...platforms, ...platforms].map((p) => (
          <span class="flex items-center gap-10 text-sm font-medium uppercase tracking-[0.2em] text-gray-500 whitespace-nowrap">{p}<span class="w-1.5 h-1.5 rounded-full bg-lime-300/50"></span></span>
        ))}
      </div>
    </div>

    <!-- JOURNEY -->
    <section class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
      <div data-reveal class="max-w-3xl mb-16">
        <div class={`${eyebrow} mb-4`}>/ How it fits together</div>
        <h2 style={display} class="text-3xl sm:text-4xl lg:text-[3.4rem] !leading-[1.05] mb-5">From a stranger scrolling to a paying customer, with no one pressing a button.</h2>
        <p class="text-gray-400 text-lg leading-relaxed">Each system hands the person to the next one. That chain is what most businesses are missing: they have some of the pieces, but nothing connects them.</p>
      </div>
      <div class="relative">
        <div class="hidden lg:block absolute left-[7%] right-[7%] top-[47px] h-px bg-gradient-to-r from-lime-300/0 via-lime-300/40 to-lime-300/0" aria-hidden="true"></div>
        <ol data-reveal-stagger class="relative grid gap-4 lg:grid-cols-7">
          {journey.map((j, i) => {
            const s = bySlug[j.slug]
            return (
              <li class="relative">
                <a href={link(j.slug)} data-spotlight class="group flex lg:flex-col h-full gap-4 rounded-2xl border border-white/10 bg-[#0a0e1a]/90 p-5 transition-transform hover:-translate-y-1" style={`--spot:${s.theme.primarySoft};--spot-edge:${s.theme.primary};`}>
                  <div class="relative flex-shrink-0 w-14 h-14 rounded-full flex items-center justify-center text-base font-bold text-[#070a13]" style={`background: linear-gradient(135deg, ${s.theme.primary}, ${s.theme.secondary}); box-shadow: 0 0 30px -4px ${s.theme.primary};`}>{i + 1}</div>
                  <div>
                    <div class="text-base font-semibold text-white mb-1.5 leading-snug">{j.step}</div>
                    <p class="text-sm text-gray-400 leading-relaxed mb-3">{j.body}</p>
                    <span class="text-xs font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all" style={`color: ${s.theme.primary};`}>{s.title} →</span>
                  </div>
                </a>
              </li>
            )
          })}
        </ol>
      </div>
      <a data-reveal href={link('supabase-database-data-orchestration-analytics')} data-spotlight class="group mt-4 flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6 rounded-2xl border border-violet-400/25 bg-violet-400/[0.06] p-6" style="--spot:rgba(167,139,250,.14);--spot-edge:#a78bfa;">
        <div class="text-xs font-mono uppercase tracking-widest text-violet-300 flex-shrink-0">Underneath all of it</div>
        <div class="text-sm text-gray-300 flex-1">One database that every step reads and writes, keeps private data private, and tells the owner what really happened each day.</div>
        <span class="text-xs font-semibold text-violet-300 flex-shrink-0">Database & Data Orchestration →</span>
      </a>
    </section>

    <!-- SYSTEMS -->
    <section id="systems" class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-24 lg:pb-32 scroll-mt-24">
      <div data-reveal class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-14">
        <div class="max-w-3xl">
          <div class={`${eyebrow} mb-4`}>/ The eight systems</div>
          <h2 style={display} class="text-3xl sm:text-4xl lg:text-[3.4rem] !leading-[1.05]">Each one is a product we can build for you.</h2>
        </div>
        <p class="text-gray-400 max-w-md leading-relaxed">Every card opens a full case study: the problem, what we built, the results, and how a business like yours could use it.</p>
      </div>

      <div data-reveal-stagger class="grid md:grid-cols-2 gap-5">
        {totalFootballCaseStudies.map((s, i) => (
          <a href={link(s.slug)} data-spotlight class="group relative overflow-hidden rounded-[28px] border bg-gradient-to-br from-[#0d1322] to-[#080b14] p-7 sm:p-9 transition-transform duration-500 hover:-translate-y-1" style={`border-color: ${s.theme.primaryBorder}; --spot:${s.theme.primarySoft}; --spot-edge:${s.theme.primary};`}>
            <div class="absolute -top-28 -right-28 w-72 h-72 rounded-full blur-3xl opacity-50 group-hover:opacity-90 transition-opacity duration-500" style={`background: ${s.theme.primarySoft};`}></div>
            <div class="absolute right-6 bottom-2 text-[9rem] leading-none font-black text-white/[0.03] select-none" style="font-family: 'Sora', sans-serif;" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
            <div class="relative">
              <div class="flex items-center justify-between mb-7">
                <span class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.2em]" style={`color: ${s.theme.primary};`}>
                  <span class="w-1.5 h-1.5 rounded-full" style={`background:${s.theme.primary}; box-shadow: 0 0 10px ${s.theme.primary};`}></span>{s.industry}
                </span>
                <span class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center text-gray-400 group-hover:text-white group-hover:border-white/30 group-hover:translate-x-1 transition-all duration-300" set:html={arrow} />
              </div>
              <h3 style="font-family: 'Sora', sans-serif; font-weight: 700; letter-spacing: -0.035em;" class="text-2xl sm:text-[2rem] leading-tight text-white mb-3">{s.title}</h3>
              <p class="text-gray-400 leading-relaxed mb-7">{s.summary}</p>
              {s.metrics && (
                <div class="grid grid-cols-2 gap-3 mb-6">
                  {s.metrics.slice(0, 2).map((m) => (
                    <div class="rounded-2xl bg-white/[0.03] border border-white/[0.07] px-4 py-3.5">
                      <div data-count style={`font-family: 'Sora', sans-serif; font-weight: 800; color: ${s.theme.primary};`} class="text-2xl leading-none">{m.value}</div>
                      <div class="mt-2 text-[11px] uppercase tracking-[0.14em] text-gray-500 font-semibold">{m.label}</div>
                    </div>
                  ))}
                </div>
              )}
              {s.businessUses && (
                <div class="text-sm text-gray-400"><span class="text-gray-500 uppercase text-[11px] tracking-[0.16em] font-semibold mr-2">Great for</span>{s.businessUses.map((u) => u.title).join(' · ')}</div>
              )}
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- TIMELINE -->
    <section class="relative border-y border-white/[0.06] bg-gradient-to-b from-white/[0.02] to-transparent">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32 grid lg:grid-cols-12 gap-12">
        <div data-reveal class="lg:col-span-5 lg:sticky lg:top-32 self-start">
          <div class={`${eyebrow} mb-4`}>/ Timeline</div>
          <h2 style={display} class="text-3xl sm:text-4xl lg:text-5xl !leading-[1.06] mb-5">Eight weeks, empty folder to paid plans.</h2>
          <p class="text-gray-400 text-lg leading-relaxed">Every week without a working product is a week of guessing. We ship something real every week and let users tell us what comes next.</p>
        </div>
        <ol data-reveal-stagger class="lg:col-span-7 relative ml-2 space-y-9 before:absolute before:left-0 before:top-2 before:bottom-2 before:w-px before:bg-gradient-to-b before:from-lime-300/70 before:via-emerald-300/40 before:to-amber-300/10">
          {timeline.map((t) => (
            <li class="pl-9 relative">
              <span class="absolute -left-[6px] top-1.5 w-3 h-3 rounded-full bg-lime-300 shadow-[0_0_0_5px_#070a13,0_0_18px_2px_rgba(163,230,53,.55)]"></span>
              <div class="text-xs font-mono uppercase tracking-[0.2em] text-lime-200/80 mb-1.5">{t.date}</div>
              <div class="text-gray-200 text-lg leading-relaxed">{t.text}</div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- WHY -->
    <section class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
      <div data-reveal class="max-w-3xl mb-14">
        <div class={`${eyebrow} mb-4`}>/ Why this matters to you</div>
        <h2 style={display} class="text-3xl sm:text-4xl lg:text-[3.4rem] !leading-[1.05]">You hire the team that already ran it.</h2>
      </div>
      <div data-reveal-stagger class="grid md:grid-cols-3 gap-5">
        {[
          { t: 'Proven, not promised', b: 'Every system here runs in production with real users and real money. You are not paying for us to learn.' },
          { t: 'It all connects', b: 'We build the pieces to work together: your videos feed your list, your list feeds your sales, and your data shows what works.' },
          { t: 'Start with one', b: 'Most clients start with the system that hurts most today, like comment-to-DM or email, and add the rest when it pays for itself.' },
        ].map((c, i) => (
          <div data-spotlight class="rounded-3xl border border-white/10 bg-gradient-to-b from-white/[0.04] to-transparent p-8">
            <div class="w-11 h-11 rounded-2xl bg-lime-300/10 border border-lime-300/25 flex items-center justify-center text-lime-300 font-bold mb-6" style="font-family: 'Sora', sans-serif;">{i + 1}</div>
            <div class="text-white text-lg font-semibold mb-2">{c.t}</div>
            <p class="text-gray-400 leading-relaxed">{c.b}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-24">
      <div data-reveal class="text-center mb-10">
        <div class={`${eyebrow} mb-4`}>/ Questions</div>
        <h2 style={display} class="text-3xl sm:text-4xl leading-tight">Common questions</h2>
      </div>
      <div data-reveal-stagger class="space-y-3">
        {faqs.map((f) => (
          <details class="group rounded-2xl border border-white/[0.08] bg-white/[0.02] px-6 py-5 open:bg-white/[0.04] open:border-lime-300/25 transition-colors">
            <summary class="cursor-pointer list-none flex items-center justify-between gap-4 text-white font-semibold text-lg">
              {f.question}
              <span class="flex-shrink-0 w-8 h-8 rounded-full border border-white/10 flex items-center justify-center text-lime-300 transition-transform duration-300 group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-gray-400 leading-relaxed">{f.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-28">
      <div data-reveal class="relative overflow-hidden rounded-[36px] border border-lime-300/25 bg-gradient-to-br from-lime-300/[0.12] via-[#0b101d] to-emerald-400/[0.08] px-6 py-16 sm:px-14 sm:py-20 text-center">
        <div class="absolute left-1/2 top-0 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] rounded-full bg-lime-300/20 blur-[120px] pointer-events-none"></div>
        <div class="relative max-w-2xl mx-auto">
          <h2 style={display} class="text-3xl sm:text-5xl !leading-[1.05] mb-5">Want one of these in your business?</h2>
          <p class="text-gray-300 text-lg leading-relaxed mb-9">Tell us what takes your team the most time today. We will tell you which system fixes it, what it costs and how long it takes, in a free call.</p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href="/contact/" class="fx-shine inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full font-semibold text-[#070a13] bg-gradient-to-r from-lime-300 to-emerald-300 shadow-[0_10px_40px_-10px_rgba(163,230,53,.6)]">Book a free call <Fragment set:html={arrow} /></a>
            <a href="/case-studies/" class="inline-flex items-center justify-center px-8 py-4 rounded-full font-medium text-gray-200 bg-white/5 border border-white/10 hover:bg-white/10 transition-colors">See our client case studies</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
